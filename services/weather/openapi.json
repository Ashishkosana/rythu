{
  "openapi": "3.1.0",
  "info": {
    "title": "Rythu API",
    "description": "Honest weather + farming advice for Telangana farmers.",
    "version": "1"
  },
  "paths": {
    "/v1/weather": {
      "get": {
        "tags": [
          "weather"
        ],
        "summary": "Forecast and farming reads for a point",
        "operationId": "weather_v1_weather_get",
        "parameters": [
          {
            "name": "lat",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Decimal degrees. Give lat and lon together, or neither (defaults to Bhupalpally). Telangana + border only.",
              "title": "Lat"
            },
            "description": "Decimal degrees. Give lat and lon together, or neither (defaults to Bhupalpally). Telangana + border only."
          },
          {
            "name": "lon",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Decimal degrees. See lat.",
              "title": "Lon"
            },
            "description": "Decimal degrees. See lat."
          },
          {
            "name": "crop",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "One of: cotton, paddy, red_gram, maize, chilli. Omit for crop-independent reads only.",
              "title": "Crop"
            },
            "description": "One of: cotton, paddy, red_gram, maize, chilli. Omit for crop-independent reads only."
          },
          {
            "name": "water",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "One of: canal_lift, tank, borewell, rainfed. Default rainfed.",
              "title": "Water"
            },
            "description": "One of: canal_lift, tank, borewell, rainfed. Default rainfed."
          },
          {
            "name": "X-Request-Id",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Optional correlation id, echoed back if safe ([A-Za-z0-9._-]{1,128}).",
              "title": "X-Request-Id"
            },
            "description": "Optional correlation id, echoed back if safe ([A-Za-z0-9._-]{1,128})."
          }
        ],
        "responses": {
          "200": {
            "description": "Forecast + farming reads, or an honest degraded answer.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WeatherContract"
                }
              }
            }
          },
          "400": {
            "description": "Malformed request, or outside coverage (code=outside_coverage).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/geocode": {
      "get": {
        "tags": [
          "places"
        ],
        "summary": "Find a village by name (Telangana + border)",
        "operationId": "geocode_v1_geocode_get",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Village, town or mandal name (2-60 characters). Search on submit, not per keystroke.",
              "title": "Q"
            },
            "description": "Village, town or mandal name (2-60 characters). Search on submit, not per keystroke."
          },
          {
            "name": "X-Request-Id",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Optional correlation id, echoed back if safe ([A-Za-z0-9._-]{1,128}).",
              "title": "X-Request-Id"
            },
            "description": "Optional correlation id, echoed back if safe ([A-Za-z0-9._-]{1,128})."
          }
        ],
        "responses": {
          "200": {
            "description": "Matching places inside coverage (possibly none).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GeocodeResults"
                }
              }
            }
          },
          "400": {
            "description": "Query missing, too short or too long.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "503": {
            "description": "No geocoding source could be asked (code=upstream_unavailable).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/devices": {
      "post": {
        "tags": [
          "me"
        ],
        "summary": "Register this phone",
        "operationId": "register_device_v1_devices_post",
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceCredentialsOut"
                }
              }
            }
          },
          "429": {
            "description": "Too many new devices this hour.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "503": {
            "description": "Accounts unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/sessions": {
      "post": {
        "tags": [
          "me"
        ],
        "summary": "Trade the device secret for a one-hour token",
        "operationId": "start_session_v1_sessions_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SessionIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionOut"
                }
              }
            }
          },
          "400": {
            "description": "Malformed body.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "401": {
            "description": "Unknown device or wrong secret.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/me/profile": {
      "get": {
        "tags": [
          "me"
        ],
        "summary": "The profile saved by this device",
        "operationId": "get_profile_v1_me_profile_get",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileOut"
                }
              }
            }
          },
          "401": {
            "description": "Missing or expired token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "Nothing saved yet.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "me"
        ],
        "summary": "Save the profile (conditional)",
        "operationId": "put_profile_v1_me_profile_put",
        "parameters": [
          {
            "name": "if-match",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "If-Match"
            }
          },
          {
            "name": "if-none-match",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "If-None-Match"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProfileIn"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileOut"
                }
              }
            }
          },
          "400": {
            "description": "Malformed body, or a village outside coverage (code=outside_coverage).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "401": {
            "description": "Missing or expired token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "412": {
            "description": "The saved profile changed since you read it (or one already exists).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "428": {
            "description": "Send If-Match: <etag> to update, or If-None-Match: * to create.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/me": {
      "delete": {
        "tags": [
          "me"
        ],
        "summary": "Delete everything stored for this user",
        "operationId": "delete_me_v1_me_delete",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "401": {
            "description": "Missing or expired token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Liveness: the process is up",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Coords": {
        "properties": {
          "requested": {
            "$ref": "#/components/schemas/LatLon",
            "description": "The farmer's pin."
          },
          "returned": {
            "$ref": "#/components/schemas/LatLon",
            "description": "The model grid point that answered."
          },
          "elevation_m": {
            "type": "number",
            "title": "Elevation M"
          },
          "snap_distance_km": {
            "type": "number",
            "title": "Snap Distance Km",
            "description": "Distance from the farmer's pin to the grid point."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "requested",
          "returned",
          "elevation_m",
          "snap_distance_km"
        ],
        "title": "Coords"
      },
      "Crop": {
        "type": "string",
        "enum": [
          "cotton",
          "paddy",
          "red_gram",
          "maize",
          "chilli"
        ],
        "title": "Crop",
        "description": "The pilot crop set for Bhupalpally Kharif."
      },
      "DailyOut": {
        "properties": {
          "date": {
            "type": "string",
            "title": "Date",
            "description": "Local calendar date, YYYY-MM-DD. Never earlier than today."
          },
          "precipitation_probability_max": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Precipitation Probability Max"
          },
          "precipitation_sum_mm": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Precipitation Sum Mm"
          },
          "temperature_max_c": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Temperature Max C"
          },
          "temperature_min_c": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Temperature Min C"
          },
          "wind_speed_max_kmh": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Wind Speed Max Kmh"
          },
          "weather_code": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Weather Code"
          },
          "category": {
            "$ref": "#/components/schemas/WMOCategory"
          },
          "emoji": {
            "type": "string",
            "title": "Emoji"
          },
          "farm_note": {
            "type": "string",
            "title": "Farm Note"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "date",
          "precipitation_probability_max",
          "precipitation_sum_mm",
          "temperature_max_c",
          "temperature_min_c",
          "wind_speed_max_kmh",
          "weather_code",
          "category",
          "emoji",
          "farm_note"
        ],
        "title": "DailyOut"
      },
      "DeviceCredentialsOut": {
        "properties": {
          "user_id": {
            "type": "string",
            "title": "User Id",
            "description": "Random 128-bit id, 32 lowercase hex characters."
          },
          "device_secret": {
            "type": "string",
            "title": "Device Secret",
            "description": "256-bit secret. Keep on the device; trade it for tokens."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "user_id",
          "device_secret"
        ],
        "title": "DeviceCredentialsOut",
        "description": "``POST /v1/devices`` 201 body. Shown once: the server keeps only a digest of the secret."
      },
      "ErrorBody": {
        "properties": {
          "error": {
            "type": "string",
            "title": "Error"
          },
          "code": {
            "type": "string",
            "enum": [
              "bad_request",
              "outside_coverage",
              "upstream_unavailable",
              "unauthorized",
              "not_found",
              "precondition_failed",
              "precondition_required",
              "rate_limited",
              "unavailable"
            ],
            "title": "Code"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "error",
          "code"
        ],
        "title": "ErrorBody",
        "description": "4xx/5xx body. ``code`` is stable and machine-readable; ``error`` is for humans/logs."
      },
      "FarmAction": {
        "type": "string",
        "enum": [
          "spray",
          "irrigate",
          "sow",
          "harvest",
          "fieldwork",
          "scout"
        ],
        "title": "FarmAction",
        "description": "The farm operation a rule advises on. Lets the UI group reads by activity."
      },
      "FarmerContextOut": {
        "properties": {
          "crop": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Crop"
              },
              {
                "type": "null"
              }
            ]
          },
          "water_source": {
            "$ref": "#/components/schemas/WaterSource"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "crop",
          "water_source"
        ],
        "title": "FarmerContextOut"
      },
      "FarmingReadOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "action": {
            "$ref": "#/components/schemas/FarmAction"
          },
          "crop": {
            "type": "string",
            "title": "Crop",
            "description": "'any' or a crop id."
          },
          "severity": {
            "$ref": "#/components/schemas/Severity",
            "description": "UI emphasis, NOT a certainty claim."
          },
          "triggered": {
            "type": "boolean",
            "title": "Triggered"
          },
          "headline_en": {
            "type": "string",
            "title": "Headline En"
          },
          "detail_en": {
            "type": "string",
            "title": "Detail En"
          },
          "caveat_en": {
            "type": "string",
            "title": "Caveat En"
          },
          "headline_te": {
            "type": "string",
            "title": "Headline Te",
            "description": "Empty string = fall back to the English field."
          },
          "detail_te": {
            "type": "string",
            "title": "Detail Te"
          },
          "caveat_te": {
            "type": "string",
            "title": "Caveat Te"
          },
          "window_note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Window Note"
          },
          "sources": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Sources"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "action",
          "crop",
          "severity",
          "triggered",
          "headline_en",
          "detail_en",
          "caveat_en",
          "headline_te",
          "detail_te",
          "caveat_te",
          "window_note",
          "sources"
        ],
        "title": "FarmingReadOut"
      },
      "GeocodeResults": {
        "properties": {
          "results": {
            "items": {
              "$ref": "#/components/schemas/PlaceOut"
            },
            "type": "array",
            "title": "Results"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "results"
        ],
        "title": "GeocodeResults",
        "description": "``GET /v1/geocode`` 200 body: places inside Rythu's coverage, best match first (may be empty)."
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status"
        ],
        "title": "Health"
      },
      "HourlyRainOut": {
        "properties": {
          "time_local": {
            "type": "string",
            "title": "Time Local"
          },
          "precipitation_probability": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Precipitation Probability",
            "description": "Percent; null = unknown, never zero."
          },
          "precipitation_mm": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Precipitation Mm"
          },
          "temperature_c": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Temperature C"
          },
          "relative_humidity": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Relative Humidity"
          },
          "wind_speed_kmh": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Wind Speed Kmh"
          },
          "weather_code": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Weather Code"
          },
          "category": {
            "$ref": "#/components/schemas/WMOCategory"
          },
          "emoji": {
            "type": "string",
            "title": "Emoji"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "time_local",
          "precipitation_probability",
          "precipitation_mm",
          "temperature_c",
          "relative_humidity",
          "wind_speed_kmh",
          "weather_code",
          "category",
          "emoji"
        ],
        "title": "HourlyRainOut"
      },
      "LatLon": {
        "properties": {
          "lat": {
            "type": "number",
            "title": "Lat"
          },
          "lon": {
            "type": "number",
            "title": "Lon"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "lat",
          "lon"
        ],
        "title": "LatLon"
      },
      "PlaceOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "name_te": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name Te",
            "description": "Telugu name when OpenStreetMap has one; else null."
          },
          "admin2": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Admin2",
            "description": "District."
          },
          "admin1": {
            "anyOf": [
              {
